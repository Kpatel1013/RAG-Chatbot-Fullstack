# Shared formatting defaults for the whole monorepo
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,jsx,ts,tsx,css,html,json,yml,yaml,md}]
indent_size = 2

[*.{py,sh}]
indent_size = 4

[Makefile]
indent_style = tab
